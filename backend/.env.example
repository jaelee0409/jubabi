# 로컬 개발용 템플릿 — 이 파일을 .env 로 복사한 뒤 값을 채우세요.
# 프로덕션에서는 시크릿을 SSM Parameter Store(/jubabi/prod/)에서 읽으므로
# 서버 디스크에 .env 를 두지 않습니다.

# 런타임 설정 (프로덕션에서는 systemd 유닛의 Environment= 로 주입)
NODE_ENV=development
PORT=5001
BACKEND_BASE_URL=http://localhost:5001

# DB
NEON_DATABASE_URL=

# 인증
JWT_SECRET=

# DART OpenAPI
DART_API_KEY=

# Kakao OAuth
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_ADMIN_KEY=

# Claude API (AI 공시 요약)
ANTHROPIC_API_KEY=

# AWS 자격증명은 여기에 넣지 마세요.
# 로컬에서는 `aws configure` 프로필을, EC2에서는 인스턴스에 붙인 IAM 역할을 사용합니다.
